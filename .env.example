# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# These are read by the director service ONLY. The Godot client must never see
# provider credentials: it talks to the director, not to providers.
#
# STATUS: the director reads the DIRECTOR_* variables below and the
# CLOUDFLARE_* variables from its process environment (it does not load this
# file itself). The GROQ/CEREBRAS keys and the OTLP endpoint are placeholders
# for the remaining provider and telemetry issues.

# --- Director service ---
# `make run-director` reads host/port from the shell environment or make
# variables (e.g. `make run-director DIRECTOR_PORT=9000`).
DIRECTOR_HOST=127.0.0.1
DIRECTOR_PORT=8000

# --- Provider selection (read by the director; blank means default) ---
# Provider used when a request names none. Must be registered and available or
# the director refuses to start. `GET /v1/config` lists the valid ids.
DIRECTOR_DEFAULT_PROVIDER=rules-baseline
# Model for that provider; blank uses the provider's own default.
DIRECTOR_DEFAULT_MODEL=
# Per-generation timeout in seconds (> 0, <= 300). Timeouts are not retried.
DIRECTOR_TIMEOUT_SECONDS=10

# --- Cloudflare TypeSafe Jev provider (cloudflare-jev) ---
# Server-side only. Without both values the provider is registered but
# reports unavailable (the offline rules default keeps working).
# Token: Cloudflare dashboard -> Workers AI -> Use REST API (needs
# Workers AI Read + Edit permissions).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Jev model id as documented in Cloudflare's AI model catalog.
CLOUDFLARE_JEV_MODEL=typesafe/jev
# API root; override only for tests/proxies.
# CLOUDFLARE_JEV_API_BASE_URL=https://api.cloudflare.com/client/v4

# --- Provider credentials (leave blank for providers you are not using) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- Observability (OpenTelemetry) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
