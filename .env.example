# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# These are read by the director service ONLY. The Godot client must never see
# provider credentials: it talks to the director, not to providers.
#
# STATUS: the director reads the DIRECTOR_*, provider, and telemetry variables
# below from its process environment (it does not load this file itself).

# --- Director service ---
# `make run-director` reads host/port from the shell environment or make
# variables (e.g. `make run-director DIRECTOR_PORT=9000`).
DIRECTOR_HOST=127.0.0.1
DIRECTOR_PORT=8000

# --- Provider selection (read by the director; blank means default) ---
# Provider used when a request names none. Must be registered and available or
# the director refuses to start. `GET /v1/config` lists the valid ids.
DIRECTOR_DEFAULT_PROVIDER=rules-baseline
# Model for that provider; blank uses the provider's own default.
DIRECTOR_DEFAULT_MODEL=
# Per-generation timeout in seconds (> 0, <= 300). Timeouts are not retried.
DIRECTOR_TIMEOUT_SECONDS=10

# --- Shadow evaluation (read by the director; off unless TARGETS is set) ---
# Comma-separated `provider` or `provider:model` entries (max 4) that receive a
# copy of every request in the background. Only the active provider answers.
# Each target costs one upstream call per request. See director/docs/shadow-mode.md.
DIRECTOR_SHADOW_TARGETS=
# Optional tuning (bad values fall back to the defaults with a warning):
# DIRECTOR_SHADOW_TIMEOUT_SECONDS=10   # default: DIRECTOR_TIMEOUT_SECONDS
# DIRECTOR_SHADOW_MAX_IN_FLIGHT=8      # 1-64; extra shadow runs are skipped
# DIRECTOR_SHADOW_STORE_SIZE=128       # 1-1024 comparisons kept in memory
# DIRECTOR_SHADOW_DRAIN_SECONDS=5      # shutdown grace before shadows are cancelled

# --- Cloudflare TypeSafe Jev provider (cloudflare-jev) ---
# Server-side only. Without both values the provider is registered but
# reports unavailable (the offline rules default keeps working).
# Token: Cloudflare dashboard -> Workers AI -> Use REST API (needs
# Workers AI Read + Edit permissions).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Jev model id as documented in Cloudflare's AI model catalog.
CLOUDFLARE_JEV_MODEL=typesafe/jev
# API root; override only for tests/proxies.
# CLOUDFLARE_JEV_API_BASE_URL=https://api.cloudflare.com/client/v4

# --- Groq provider (groq) ---
# Server-side only. Without a key the provider is registered but reports
# unavailable (the offline rules default keeps working). Create a key at
# https://console.groq.com/keys. A malformed value below disables just this
# provider (a warning naming only the provider is logged) instead of stopping
# the director.
GROQ_API_KEY=
# Model id; the initial benchmark target. Strict structured output is supported
# on openai/gpt-oss-20b and openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-20b
# GPT-OSS accepts only low, medium or high (there is no none/minimal).
GROQ_REASONING_EFFORT=low
# Output-token cap (64-65536); assume reasoning tokens count against it. Too small a cap can leave the
# JSON truncated or empty; that is recorded as a failure, never repaired.
GROQ_MAX_COMPLETION_TOKENS=2048
# API root; override only for tests/proxies (https, or loopback http).
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Paid live tests (director/tests/test_groq_live.py) additionally need
# RUN_LIVE_GROQ=1 in the shell that runs them; never set it in a shared .env.
# RUN_LIVE_GROQ=1

# --- Cerebras Qwen provider (cerebras) ---
# Server-side only. Without a key the provider is registered but reports
# unavailable (the offline rules default keeps working).
CEREBRAS_API_KEY=
# Explicit current public Qwen model ID; override it as Cerebras offerings change.
CEREBRAS_MODEL=qwen-3.8-27b
# Output-token cap (64-2048).
CEREBRAS_MAX_COMPLETION_TOKENS=512
# API root; override only for tests/proxies (https, or loopback http).
# CEREBRAS_API_BASE_URL=https://api.cerebras.ai/v1
# Paid live tests additionally need RUN_LIVE_CEREBRAS=1 in the shell.
# RUN_LIVE_CEREBRAS=1

# --- Observability (OpenTelemetry; see observability/README.md) ---
# Telemetry is off unless an endpoint is set or DIRECTOR_OTEL_ENABLED is true.
# OTLP/HTTP base URL; the director appends /v1/traces and /v1/metrics. This is
# the receiver of the local OpenLIT stack (`docker compose -f
# observability/docker-compose.yml up -d`).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# 1/true/yes/on forces export on (endpoint defaults to http://localhost:4318),
# 0/false/no/off forces it off. Unset: follows OTEL_EXPORTER_OTLP_ENDPOINT.
# DIRECTOR_OTEL_ENABLED=
# service.name resource attribute.
# OTEL_SERVICE_NAME=dungeon-director
# Only for the OpenLIT compose stack (defaults shown; the password is a
# well-known local value, and the stack binds to 127.0.0.1 only).
# OPENLIT_DB_USER=default
# OPENLIT_DB_PASSWORD=OPENLIT
# OPENLIT_DB_NAME=openlit
# OPENLIT_TELEMETRY_ENABLED=false
