# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# These are read by the director service ONLY. The Godot client must never see
# provider credentials: it talks to the director, not to providers.
#
# STATUS: placeholder names for anticipated configuration. The director does not
# read any of these yet; provider adapters and config loading arrive in later
# issues under epic #1. Names may change when those land.

# --- Director service ---
# `make run-director` reads these from the shell environment or make variables
# (e.g. `make run-director DIRECTOR_PORT=9000`), not from the .env file.
DIRECTOR_HOST=127.0.0.1
DIRECTOR_PORT=8000

# --- Active provider (config-driven, changeable without rebuilding the game) ---
# The rules baseline needs no credentials.
DIRECTOR_ACTIVE_PROVIDER=rules

# --- Provider credentials (leave blank for providers you are not using) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- Observability (OpenTelemetry) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
