        "required": [
          "room_id",
          "depth",
          "room_type",
          "size",
          "danger",
          "enemy_density",
          "loot_density",
          "secret_probability",
          "has_secret",
          "exits",
          "environmental_tags",
          "description"
        ],
        "additionalProperties": false
