{
  "model": "qwen-3.8-27b",
  "messages": [
    {
      "role": "system",
      "content": "You are the dungeon director for a roguelike game. Generate a single semantic RoomPlan for the unexplored exit connecting back to the frontier. Return strictly valid JSON matching the requested schema."
    },
    {
      "role": "user",
      "content": "Generate the room behind exit north of room r-003 at depth 3. You MUST include an exit with direction='south', kind='door', locked=false connecting back to the player.\nContext: {\"task\":\"generate_room\",\"depth\":3,\"turn\":148,\"player\":{\"hp\":22,\"max_hp\":30,\"level\":4,\"conditions\":[\"poisoned\"]},\"target_exit_frontier\":{\"from_room\":\"r-003\",\"exit_direction\":\"north\",\"required_backlink\":{\"direction\":\"south\",\"kind\":\"door\",\"locked\":false}},\"options\":{\"max_danger\":3,\"forbidden_room_types\":[\"vault\"],\"allow_secrets\":true,\"target_enemy_density\":0.2,\"target_loot_density\":0.4},\"prompt_hint\":\"Player is cautious and low on HP; prefer a safer room with a chance of food.\"}"
    }
  ],
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "room_plan",
      "strict": true,
